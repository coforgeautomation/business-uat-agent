{
  "name": "business-uat-agent",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "keywords": [],
  "type": "commonjs",
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^18.0.5",
    "express": "^5.3.0",
    "zod": "^4.6.5"
  },
  "scripts": {
    "test1": "playwright test",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:web": "playwright test",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:ui": "playwright test --ui",
    "test:chromium": "playwright test --project=chromium",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit",
    "ai:connection": "tsx packages/ai/tests/connection.ts",
    "ai:orchestrate": "tsx packages/ai/tests/orchestration.ts",
    "jira:test": "tsx packages/integrations/jira/test-jira.ts",
    "web": "cd apps/web && npm run dev",
    "api": "npx tsx apps/api/src/server.ts",
    "dev:web": "cd apps/web && npm run dev",
    "dev:api": "npx tsx apps/api/src/server.ts",
    "execute:tests": "tsx packages/execution/index.ts"
  }
}
